## Command

```shell
biome migrate eslint --write
```

## `biome.json`

```json
{
  "linter": { "enabled": true, "rules": { "preset": "none" } },
  "overrides": [
    {
      "includes": ["never.js"],
      "linter": { "rules": { "style": { "useSingleVarDeclarator": "error" } } }
    },
    {
      "includes": ["kinds.js"],
      "linter": { "rules": { "style": { "useSingleVarDeclarator": "error" } } }
    },
    { "includes": ["mixed.js"], "linter": { "rules": {} } }
  ]
}
```

## `.eslintrc.json`

```json
{
        "rules": {
            "one-var": "error"
        },
        "overrides": [{
            "files": "never.js",
            "rules": {
                "one-var": ["error", "never"]
            }
        }, {
            "files": "kinds.js",
            "rules": {
                "one-var": ["error", { "var": "never", "let": "never", "const": "never" }]
            }
        }, {
            "files": "mixed.js",
            "rules": {
                "one-var": ["error", { "initialized": "never", "uninitialized": "always" }]
            }
        }]
    }
```

